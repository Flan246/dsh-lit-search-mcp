  "type": "module",
  "bin": { "dsh-lit-search-mcp": "./dist/mcp.js" },
  "mcpName": "io.github.Flan246/dsh-lit-search",
  "files": ["dist", "server.json", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": { "build": "tsdown", "test": "vitest run", "prepack": "tsdown" },
  "dependencies": { "dsh-lit-search": "^0.2.2" },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
